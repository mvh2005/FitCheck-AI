{
  "expo": {
    "name": "FitCheck.ai",
    "slug": "fitcheck-ai",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "fitcheck",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#F5F0E8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitCheck needs access to your photo library to add clothes to your wardrobe.",
          "cameraPermission": "FitCheck needs camera access to photograph your clothes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FitCheck uses your location to fetch local weather for outfit recommendations."
        }
      ]
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.fitcheck.app"
    },
    "android": {
      "package": "ai.fitcheck.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
